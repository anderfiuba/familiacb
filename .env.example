# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# NUNCA exponha no navegador. Só existe no servidor (Vercel → Environment Variables).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Cifragem das API keys dos usuários ---
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde uma cópia offline. Se perder esta chave, todas as API keys salvas ficam ilegíveis.
CREDENTIALS_ENCRYPTION_KEY=

# --- URL pública do site (usada nos convites e na checagem de origem) ---
APP_URL=https://familiacb.vercel.app

# --- Proxy de saída com IP fixo (obrigatório para o saque automático do Mercado Bitcoin) ---
# Formato: http://usuario:senha@IP:PORTA   (o TLS continua ponta a ponta via CONNECT)
# Deixe vazio para desativar; nesse caso o envio de USDT pela API pode ser recusado pelo MB.
MB_EGRESS_PROXY_URL=
